# Source de connaissances DISTANTE — base QDRANT du projet « latelier ».
# Copier en `.env.latelier` (gitignoré) et renseigner les valeurs. start.sh le source
# automatiquement s'il existe. Sans ce fichier, l'outil fonctionne normalement (la
# recherche distante est juste désactivée).
#
# Récupérer les valeurs depuis Railway (projet Latelier) :
#   railway link --project Latelier
#   railway variables -s latelier --kv | grep -E '^VOYAGE_API_KEY='
#   railway variables -s qdrant   --kv | grep -E 'RAILWAY_TCP_PROXY'   # domaine:port public
#
# Endpoint QDRANT : proxy TCP public du service qdrant (HTTP sur le port 6333 interne).
LATELIER_QDRANT_URL=http://<RAILWAY_TCP_PROXY_DOMAIN>:<RAILWAY_TCP_PROXY_PORT>
LATELIER_QDRANT_COLLECTION=mecano_chunks
LATELIER_EMBED_MODEL=voyage-3
VOYAGE_API_KEY=<clé Voyage AI du service latelier>
